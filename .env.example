# Скопировать в .env и вписать значения. .env в репозиторий не коммитится.

# Прямой OpenAI-ключ имеет приоритет. На Vercel приложение также автоматически
# использует VERCEL_OIDC_TOKEN через AI Gateway; этот временный токен вручную не задавайте.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra

# Необязательный постоянный ключ Vercel AI Gateway для локальной разработки.
AI_GATEWAY_API_KEY=
# Gateway-модель по умолчанию бесплатна. С прямым OPENAI_API_KEY используется OPENAI_MODEL.
AI_GATEWAY_MODEL=inclusionai/ling-3.0-flash-sante-free

# Максимальное качество рассуждений. Для более дешёвой и быстрой работы: high или medium.
OPENAI_REASONING_EFFORT=max
OPENAI_MAX_OUTPUT_TOKENS=6000

# fallback — работа без обращений к модели (страховка на защите при проблемах с сетью)
AI_MODE=

REQUEST_TIMEOUT_SECONDS=180
APP_PORT=8000

# Рабочие данные по умолчанию хранятся в .sana-data/ вне Git.
SANA_DATA_DIR=

# PostgreSQL/Neon. Если строка задана, база заменяет локальные JSON-файлы.
DATABASE_URL=

# Только для совместимости старых автоматических тестов. На рабочем сайте оставьте 0.
SANA_LEGACY_MODE=0
